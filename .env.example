# Copie para .env (fora do git) e preencha. Nunca comitar o .env.
# OAB monitorada pelo coletor (somente digitos no numero)
OAB_NUMERO=
OAB_UF=

# Nome do advogado, como sai no cabecalho do relatorio
ADVOGADO_NOME=

# Chave publica da API do DataJud.
# Fonte oficial: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# O CNJ pode trocar a chave a qualquer momento; reler a wiki quando der 401.
DATAJUD_API_KEY=
